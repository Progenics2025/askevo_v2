# Production Environment Variables
# For Custom Domain Deployment (chat.progenicslabs.com)

# API Configuration - Production Backend
# These should point to your reverse proxy/tunnel endpoints
VITE_API_URL=https://chat.progenicslabs.com/api
VITE_GENOMICS_API_URL=https://chat.progenicslabs.com/api

# Ollama Configuration - Production
# This should be proxied through your web server
VITE_OLLAMA_URL=https://chat.progenicslabs.com/ollama
VITE_OLLAMA_MODEL=gemma3n:latest

# Environment
VITE_ENV=production

# Language Settings
VITE_DEFAULT_LANGUAGE=en

# -----------------------------------------------------
# IMPORTANT: CLOUDFLARE TUNNEL / NGINX CONFIGURATION
# -----------------------------------------------------
# 
# You need to configure your reverse proxy to route:
#   https://chat.progenicslabs.com/api/*    → http://localhost:3001/api/*
#   https://chat.progenicslabs.com/ollama/* → http://localhost:11434/*
#   https://chat.progenicslabs.com/*        → Serve built static files from /dist
#
# Example Cloudflare Tunnel config.yml:
# 
# tunnel: YOUR_TUNNEL_ID
# credentials-file: /path/to/credentials.json
# 
# ingress:
#   - hostname: chat.progenicslabs.com
#     path: /api/*
#     service: http://localhost:3001
#   - hostname: chat.progenicslabs.com
#     path: /ollama/*
#     service: http://localhost:11434
#   - hostname: chat.progenicslabs.com
#     service: http://localhost:8080  # Serve static files with nginx or similar
#   - service: http_status:404
#
# -----------------------------------------------------
# Example NGINX Configuration:
# -----------------------------------------------------
#
