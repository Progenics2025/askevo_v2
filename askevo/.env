# Frontend Environment Variables
# Created: 2025-12-02

# API Configuration - Backend Server
VITE_API_URL=http://localhost:3001/api
VITE_GENOMICS_API_URL=http://localhost:3001/api

# Ollama Configuration
# Using Vite proxy to avoid CORS issues
# The /ollama path is proxied to http://localhost:11434 by Vite
VITE_OLLAMA_URL=/ollama
VITE_OLLAMA_MODEL=gemma3n:latest

# Environment
VITE_ENV=development

# Language Settings
VITE_DEFAULT_LANGUAGE=en

# For Custom Domain Deployment (uncomment and update these)
# VITE_API_URL=https://chat.progenicslabs.com/api
# VITE_GENOMICS_API_URL=https://chat.progenicslabs.com/api
# VITE_OLLAMA_URL=https://chat.progenicslabs.com/ollama
# VITE_ENV=production
